# ---- Local `npm run dev` (no Docker) ----
# Full connection string, used directly by the app, drizzle-kit, and the
# migration/seed scripts when running outside Docker.
DATABASE_URL=postgresql://lcpumps:lcpumps_dev_password@localhost:5433/lcpumps

# ---- Docker Compose (production) ----
# docker-compose.yml derives DATABASE_URL for the `app`/`migrator` services
# from these three instead of the line above, so they must stay in sync with
# whatever Postgres actually has. POSTGRES_PASSWORD has no default — compose
# refuses to start without it.
POSTGRES_USER=lcpumps
POSTGRES_PASSWORD=
POSTGRES_DB=lcpumps

# Domain Caddy requests a certificate for, e.g. lcpumps.com. Needs a DNS A
# record pointing at the VPS before `docker compose up` — Caddy will keep
# retrying certificate issuance until it resolves. For a domain-less local
# test, this can be left as a placeholder; use http://localhost:8080 instead
# of the Caddy :80/:443 block (see Caddyfile).
DOMAIN=example.com

# 32+ random bytes, base64 or hex, used to sign the admin session cookie (HS256).
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# File storage driver. "local" is the only implementation for now.
STORAGE_DRIVER=local

# Local-disk storage roots (used when STORAGE_DRIVER=local).
# Public: served directly by Next.js static file handling (product images).
# Private: never served directly, only through the authenticated attachment
# download route (contact-form attachments).
# Inside Docker these are the mount points for the uploads_public/
# uploads_private volumes (see docker-compose.yml) — don't change them for
# the containerized deployment.
UPLOADS_PUBLIC_DIR=./public/uploads
UPLOADS_PRIVATE_DIR=./data/uploads

NODE_ENV=development
